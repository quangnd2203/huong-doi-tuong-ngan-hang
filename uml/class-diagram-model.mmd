classDiagram
    direction TB

    class User {
        <<abstract>>
        -String userId
        -String username
        -String passwordHash
        -UserStatus status
        -boolean mustChangePassword
        +getUserId() String
        +getUsername() String
        +getStatus() UserStatus
        +isMustChangePassword() boolean
        +changePassword(...) void
        +resetPassword(String temporaryHash) void
        +deactivate() void
        +getRole() UserRole*
    }

    class Customer {
        -String customerId
        -String fullName
        -String phone
        -String email
        -String address
        -List~BankAccount~ accounts
        +getAccounts() List~BankAccount~
        +changeName(String fullName) void
        +updateContactInfo(...) void
        +setPhone(String phone) void
        +setEmail(String email) void
        +setAddress(String address) void
        +addAccount(BankAccount account) void
        +deactivate() void
        +getRole() UserRole
    }

    class Employee {
        +getRole() UserRole
    }

    class BankAccount {
        <<abstract>>
        -String accountNumber
        -String customerId
        -BigDecimal balance
        -AccountStatus status
        +getAccountNumber() String
        +getCustomerId() String
        +getBalance() BigDecimal
        +getStatus() AccountStatus
        #setBalance(BigDecimal balance) void
        #setStatus(AccountStatus status) void
        +getAccountType() AccountType*
    }

    class CheckingAccount {
        +deposit(BigDecimal amount) void
        +withdraw(BigDecimal amount) void
        +close() void
        +reopen() void
        +getAccountType() AccountType
    }

    class SavingsAccount {
        -int termMonths
        -BigDecimal annualRate
        -BigDecimal earlyWithdrawalRate
        -LocalDate startDate
        -LocalDate endDate
        +calculateInterest() BigDecimal
        +calculateInterest(LocalDate onDate) BigDecimal
        +settle(LocalDate onDate) BigDecimal
        +getAccountType() AccountType
    }

    class LoanAccount {
        -BigDecimal annualRate
        -LocalDate startDate
        -LocalDate endDate
        +getTermMonths() int
        +calculateInterest() BigDecimal
        +calculateTotalDue() BigDecimal
        +repay() BigDecimal
        +getAccountType() AccountType
    }

    class Transaction {
        -String transactionId
        -BigDecimal amount
        -String fromAccountNumber
        -String toAccountNumber
        -TransactionType type
        -LocalDateTime occurredAt
        -String note
        +getTransactionId() String
        +getType() TransactionType
        +getAmount() BigDecimal
        +getOccurredAt() LocalDateTime
    }

    class UserRole {
        <<enumeration>>
        CUSTOMER
        EMPLOYEE
    }
    class UserStatus {
        <<enumeration>>
        ACTIVE
        INACTIVE
    }
    class AccountType {
        <<enumeration>>
        CHECKING
        SAVINGS
        LOAN
    }
    class AccountStatus {
        <<enumeration>>
        ACTIVE
        INACTIVE
    }
    class TransactionType {
        <<enumeration>>
        DEPOSIT
        WITHDRAWAL
        TRANSFER
        SAVINGS_OPEN
        SAVINGS_SETTLEMENT
        LOAN_DISBURSEMENT
        LOAN_REPAYMENT
    }

    User <|-- Customer
    User <|-- Employee
    BankAccount <|-- CheckingAccount
    BankAccount <|-- SavingsAccount
    BankAccount <|-- LoanAccount
    Customer "1" *-- "0..*" BankAccount : accounts
    User ..> UserRole : getRole
    User --> UserStatus : status
    BankAccount ..> AccountType : getAccountType
    BankAccount --> AccountStatus : status
    Transaction --> TransactionType : type
    Transaction ..> BankAccount : from/to account numbers
    note for Transaction "Luu so tai khoan, khong giu tham chieu BankAccount"
